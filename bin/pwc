#!/usr/bin/env python3
"""pwc — single command-line entry point for PWC's deterministic mechanism.

Installed on PATH as a symlink (install.sh -> ~/.local/bin/pwc). Resolves its own
real location through the symlink, so the scripts import from the PWC repo no
matter where the symlink lives or what the cwd is. The workspace is discovered
from the cwd (nearest .pwc/ up the tree), same as the underlying scripts —
`--workspace` overrides.

Task-database subcommands are top-level (they're the daily surface); the other
scripts are grouped under a named subcommand:

  pwc summary | detail | events | add-task | update-task | ...   -> taskdb.py
  pwc sources show | enabled | set | skill-hints | priority      -> sources.py
  pwc models show | stale | fetch | seed | set-tier              -> models.py
  pwc route --domain <d> --reasoning <n> ...                     -> route.py
  pwc cost --task <id> | --report | --sweep                      -> cost.py
  pwc coord [claude|codex|opencode] ...                          -> coord.py
  pwc spawn --task <id> --cwd <dir> ...                          -> spawn.py
  pwc worker-status --session-ids <uuid,...> | --json -          -> worker_status.py
"""

import sys
from pathlib import Path

SCRIPTS = Path(__file__).resolve().parent.parent / "scripts"
sys.path.insert(0, str(SCRIPTS))

USAGE = """\
pwc — the PWC command line

usage:
  pwc [--workspace DIR] <command> [args]

task database (see `pwc <command> -h` for each):
  summary detail stale parked-aging events find-refs find-session
  add-task update-task add-ref log-event set-session sessions backfill-sessions
  clear-session archive promote merge init

other:
  pwc sources <show|enabled|set|skill-hints|priority> [args]
  pwc models <show|stale|fetch|seed|set-tier> [args]
  pwc route --domain <code-review|implementation|research-writing|ops-comms>
            --reasoning <1-5> [--verifiability <1-5>] [--risk none|outward|prod-data]
            [--context-need <tokens>] [--explain]
  pwc cost --task <id> | --report [--since 30d] | --sweep
  pwc coord [claude|codex|opencode] [--model M] [--workspace DIR] [--name N]
  pwc spawn --task <id> --cwd <dir> [--session-id U] [--resume] [--prompt -] [--name N]
            [--skip-skill-hint --skip-skill-reason WHY]
  pwc worker-status --session-ids <uuid,...> | --json -

The workspace is discovered from the cwd (nearest .pwc/ up the tree);
pass --workspace to override (before the command for taskdb, after
`sources` for sources).
"""


def _extract_workspace(argv):
    """Pull a `--workspace DIR` / `--workspace=DIR` out of argv from ANY position.

    Returns (ws_or_None, argv_without_it). The scripts want --workspace as a leading
    global; callers (and the find-work skill) write it after the subcommand too, so we
    normalize here. First occurrence wins; the flag and its value are removed. A bare
    trailing `--workspace` with no value is left in place for argparse to complain
    about in the normal way.
    """
    out = []
    ws = None
    i = 0
    while i < len(argv):
        tok = argv[i]
        if ws is None and tok == "--workspace" and i + 1 < len(argv):
            ws = argv[i + 1]
            i += 2
            continue
        if ws is None and tok.startswith("--workspace="):
            ws = tok.split("=", 1)[1]
            i += 1
            continue
        out.append(tok)
        i += 1
    return ws, out


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return

    # `--workspace DIR` belongs to whichever subcommand follows it, not to taskdb
    # specifically. Lift it out and hand it to the right script, so
    # `pwc --workspace X sources runhosts` works exactly like `pwc sources
    # runhosts` does from inside X. (Before this, a leading --workspace shunted
    # EVERYTHING to taskdb, so that invocation died with "invalid choice:
    # 'sources'" — a papercut that only got sharper once coordinating from a
    # parent directory made --workspace routine.)
    #
    # Accept it ANYWHERE, not just leading. The underlying scripts declare
    # --workspace as a LEADING global (argparse rejects it after the subcommand), but
    # a human — and the find-work skill, which documents `pwc sources priority
    # --workspace <root>` — naturally writes it AFTER the subcommand. So pull it out
    # of any position here and re-inject it where the scripts expect it, rather than
    # dying with a cryptic "unrecognized arguments: --workspace …". (This bit for
    # real the first time find-work ran from ~/work across two boards.)
    # spawn takes --cwd, not --workspace, and just forwards the rest to a worker —
    # so never rewrite ITS args. For everything else, lift --workspace from anywhere.
    _first = argv[1] if argv[0] == "--workspace" and len(argv) > 1 else argv[0]
    if _first in ("spawn", "coord"):
        ws = None
    else:
        ws, argv = _extract_workspace(argv)
    if not argv:
        print(USAGE)
        return

    cmd, rest = argv[0], argv[1:]
    # sources/cost/taskdb all declare --workspace as a LEADING global (before their
    # own subcommand), so hand it back in that position. spawn takes --cwd instead
    # and has no --workspace at all, so it never gets one.
    if ws is not None:
        if cmd in ("sources", "cost"):
            rest = ["--workspace", ws, *rest]
        elif cmd in ("spawn", "coord"):
            pass  # spawn is located by --cwd; coord declares its own --workspace
        else:
            argv = ["--workspace", ws, *argv]

    if cmd == "sources":
        import sources
        sources.main(rest)
    elif cmd == "models":
        import models
        models.main(rest)
    elif cmd == "route":
        import route
        route.main(rest)
    elif cmd == "cost":
        import cost
        cost.main(rest)
    elif cmd == "coord":
        import coord
        raise SystemExit(coord.main(rest))
    elif cmd == "spawn":
        import spawn
        spawn.main(rest)
    elif cmd == "worker-status":
        import worker_status
        worker_status.main(rest)
    else:
        # Everything else is a taskdb subcommand (incl. a leading --workspace).
        import taskdb
        taskdb.main(argv)


if __name__ == "__main__":
    main(sys.argv[1:])
