#!/usr/bin/env python3
"""pwc — single command-line entry point for PWC's deterministic mechanism.

Installed on PATH as a symlink (install.sh -> ~/.local/bin/pwc). Resolves its own
real location through the symlink, so the scripts import from the PWC repo no
matter where the symlink lives or what the cwd is. The workspace is discovered
from the cwd (nearest .pwc/ up the tree), same as the underlying scripts —
`--workspace` overrides.

Task-database subcommands are top-level (they're the daily surface); the other
scripts are grouped under a named subcommand:

  pwc summary | detail | events | add-task | update-task | ...   -> taskdb.py
  pwc sources show | enabled | set | skill-hints | priority      -> sources.py
  pwc spawn --task <id> --cwd <dir> ...                          -> spawn.py
  pwc worker-status --session-ids <uuid,...> | --json -          -> worker_status.py
"""

import sys
from pathlib import Path

SCRIPTS = Path(__file__).resolve().parent.parent / "scripts"
sys.path.insert(0, str(SCRIPTS))

USAGE = """\
pwc — the PWC command line

usage:
  pwc [--workspace DIR] <command> [args]

task database (see `pwc <command> -h` for each):
  summary detail stale parked-aging events find-refs find-session
  add-task update-task add-ref log-event set-session clear-session
  archive promote merge init

other:
  pwc sources <show|enabled|set|skill-hints|priority> [args]
  pwc spawn --task <id> --cwd <dir> [--session-id U] [--resume] [--prompt -] [--name N]
  pwc worker-status --session-ids <uuid,...> | --json -

The workspace is discovered from the cwd (nearest .pwc/ up the tree);
pass --workspace to override (before the command for taskdb, after
`sources` for sources).
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "sources":
        import sources
        sources.main(rest)
    elif cmd == "spawn":
        import spawn
        spawn.main(rest)
    elif cmd == "worker-status":
        import worker_status
        worker_status.main(rest)
    else:
        # Everything else is a taskdb subcommand (incl. a leading --workspace).
        import taskdb
        taskdb.main(argv)


if __name__ == "__main__":
    main(sys.argv[1:])
